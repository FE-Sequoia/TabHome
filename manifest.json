{
  "manifest_version": 3,
  "name": "TabHome 大宝标签管理器",
  "short_name": "TabHome",
  "description": "一个本地标签管理插件，用于替换默认的新标签页，支持标签分类管理和数据导入导出。",
  "version": "1.0.2",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": "icons/icon.ico"
  },
  "icons": {
    "16": "icons/icon.ico",
    "32": "icons/icon.ico",
    "48": "icons/icon.ico",
    "128": "icons/icon.ico"
  }
}